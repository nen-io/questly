# Copy this file to `.env` when running the Docker/Podman compose stacks.

# Postgres container credentials.
DB_USER=questly
DB_PASSWORD=questly
DB_NAME=questly

# Exposed app ports.
API_PORT=3000
WEB_PORT=3002

# Public URLs used by links, CORS, and ngrok/local browser access.
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Seeded admin account defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Game Admin

# Seeded realm identity.
REALM_SLUG=questly-home
REALM_NAME=Questly

# Auth and security.
JWT_SECRET=replace-with-a-long-random-string

# Email verification and optional SMTP delivery.
EMAIL_VERIFICATION_EXPIRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Questly
