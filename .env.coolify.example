# Copy this file to `.env.coolify` for local validation or mirror the same keys
# into Coolify's environment variables UI for the compose deployment.
#
# Public routes currently configured in Coolify:
# API: https://i4c484o44oso8s08s8oogc4c.217.216.43.183.sslip.io
# Web: https://fckc40wwc4c8g8ws8o4g48o8.217.216.43.183.sslip.io
#
# The bundled web app should keep using same-origin `/api` so auth cookies and
# realtime traffic stay on the web domain even if Coolify also exposes the API
# on its own hostname.

# Postgres container credentials.
DB_USER=questly
DB_PASSWORD=questly
DB_NAME=questly

# Internal container port exposed by the API service.
API_PORT=3000

# Public browser-facing URLs used for CORS, email links, and cookie scope.
APP_BASE_URL=https://fckc40wwc4c8g8ws8o4g48o8.217.216.43.183.sslip.io
FRONTEND_URL=https://fckc40wwc4c8g8ws8o4g48o8.217.216.43.183.sslip.io
VITE_API_URL=/api

# Auth and cookie settings.
JWT_SECRET=replace-with-a-long-random-string
AUTH_COOKIE_NAME=questly_auth
ALLOW_ANY_ORIGIN=false
COOKIE_SECURE=true

# Seeded admin account defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Game Admin

# Seeded realm identity.
REALM_SLUG=questly-home
REALM_NAME=Questly
SKIP_ONBOARDING_PLAYER_PASSWORD=questly-player
SKIP_ONBOARDING_THEME_KEY=couples-glow

# Email verification and optional SMTP delivery.
EMAIL_VERIFICATION_EXPIRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Questly

# Optional S3/object storage for avatars, content, and win media.
S3_BUCKET_NAME=
AWS_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
S3_AVATAR_PREFIX=avatars
S3_CONTENT_PREFIX=content
S3_MEDIA_PREFIX=wins

# Runtime tuning defaults.
PASSWORD_HASH_ROUNDS=12
TASK_EXPIRY_SWEEP_INTERVAL_MS=300000
TASK_RUN_MEDIA_PROCESSING_INTERVAL_MS=15000
TASK_RUN_MEDIA_PROCESSING_BATCH_SIZE=3
TASK_RUN_MEDIA_PROCESSING_LOCK_TIMEOUT_MS=120000
TASK_RUN_MEDIA_PROCESSING_MAX_ATTEMPTS=12
