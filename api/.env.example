# Copy this file to `api/.env` for local API development.
# Docker compose also loads this file into the API container.

# Database connection.
# If DATABASE_URL is set it takes precedence over DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=postgres://questly:questly@localhost:5432/questly
DB_USER=questly
DB_PASSWORD=questly
DB_NAME=questly

# Server and browser integration.
API_PORT=3000
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOW_ANY_ORIGIN=false

# Auth and cookie settings.
JWT_SECRET=replace-with-a-long-random-string
AUTH_COOKIE_NAME=questly_auth
COOKIE_SECURE=false

# Seed and onboarding defaults.
REALM_SLUG=questly-home
REALM_NAME=Questly
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Game Admin
SKIP_ONBOARDING_PLAYER_PASSWORD=questly-player
SKIP_ONBOARDING_THEME_KEY=couples-glow

# Email verification and notifications.
EMAIL_VERIFICATION_EXPIRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Questly

# Object storage for avatars, content media, and wins.
# Leave these blank if S3-backed media is not configured yet.
S3_BUCKET_NAME=
AWS_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
S3_AVATAR_PREFIX=avatars
S3_CONTENT_PREFIX=content
S3_MEDIA_PREFIX=wins

# Background worker tuning.
PASSWORD_HASH_ROUNDS=12
TASK_EXPIRY_SWEEP_INTERVAL_MS=300000
TASK_RUN_MEDIA_PROCESSING_INTERVAL_MS=15000
TASK_RUN_MEDIA_PROCESSING_BATCH_SIZE=3
TASK_RUN_MEDIA_PROCESSING_LOCK_TIMEOUT_MS=120000
TASK_RUN_MEDIA_PROCESSING_MAX_ATTEMPTS=12
